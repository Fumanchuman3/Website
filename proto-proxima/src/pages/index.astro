---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allPosts.slice(0, 3);  // top 3 as featured cards
const latest = allPosts.slice(0, 4);    // top 4 in the list below
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>

      <!-- FEATURED -->
      <section>
        <div class="section-header">
          <h2 class="section-title">Featured Content</h2>
        </div>
        <div class="featured-grid">
          {featured.map((post, i) => (
            <a href={`/blog/${post.slug}`} class={`featured-card ${i === 0 ? 'featured-card--big' : ''}`}>
              <div class="card-img-wrap">
                <div class="card-img img-placeholder">📝</div>
              </div>
              <div class="card-body">
                <span class="card-type">blog</span>
                <h3 class="card-title">{post.data.title}</h3>
                <p class="card-desc">{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- LATEST POSTS -->
      <section>
        <div class="section-header">
          <h2 class="section-title">Latest Posts</h2>
          <a href="/blog" class="view-all">View all posts →</a>
        </div>
        <div class="posts-list">
          {latest.map(post => (
            <a href={`/blog/${post.slug}`} class="post-item">
              <div class="post-thumb img-placeholder">📄</div>
              <div class="post-content">
                <h3 class="post-title">{post.data.title}</h3>
                <p class="post-desc">{post.data.description}</p>
                <div class="post-meta">
                  <span class="post-date">
                    {new Date(post.data.pubDate).toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- NEWSLETTER -->
      <section class="newsletter">
        <h2>Stay Updated</h2>
        <p>Subscribe to get notified when I publish new posts.</p>
        <div class="newsletter-form">
          <input type="email" placeholder="your@email.com" />
          <button class="btn">Subscribe</button>
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
  /* ── SECTION HEADERS ── */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    margin-top: 3rem;
  }

  .section-title {
    font-family: 'Lora', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text);
  }

  .view-all {
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .view-all:hover { opacity: 0.7; }

  /* ── FEATURED GRID ── */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .featured-card {
    background: var(--bg);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  .featured-card:hover { background: var(--bg2); }

  .featured-card--big {
    grid-column: 1 / -1;
  }

  .card-img-wrap { overflow: hidden; }

  .card-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .featured-card--big .card-img {
    aspect-ratio: 16/7;
  }

  .featured-card:hover .card-img { transform: scale(1.02); }

  .card-body {
    padding: 1.25rem 1.4rem 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-type {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.6rem;
    font-weight: 500;
  }

  .card-title {
    font-family: 'Lora', serif;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    margin-bottom: 0.6rem;
    transition: color 0.2s;
  }

  .featured-card--big .card-title { font-size: 1.4rem; }
  .featured-card:hover .card-title { color: var(--accent); }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ── LATEST POSTS ── */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .post-item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.2rem;
    padding: 1.25rem 1.4rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
    align-items: start;
  }

  .post-item:last-child { border-bottom: none; }
  .post-item:hover { background: var(--bg2); }

  .post-thumb {
    width: 100px;
    height: 68px;
    border-radius: 4px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .post-content { min-width: 0; }

  .post-title {
    font-family: 'Lora', serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
    margin-bottom: 0.35rem;
    transition: color 0.2s;
  }

  .post-item:hover .post-title { color: var(--accent); }

  .post-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta { display: flex; gap: 0.75rem; align-items: center; }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  /* ── PLACEHOLDER ── */
  .img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--text-dim);
    min-height: 68px;
  }

  /* ── NEWSLETTER ── */
  .newsletter {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    background: var(--bg2);
    margin-top: 3rem;
    text-align: center;
  }

  .newsletter h2 {
    font-family: 'Lora', serif;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .newsletter p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .newsletter-form input {
    flex: 1;
    padding: 0.6rem 1rem;
    font-size: 0.875rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
  }

  .newsletter-form input:focus { border-color: var(--accent); }
  .newsletter-form input::placeholder { color: var(--text-dim); }

  .btn {
    padding: 0.6rem 1.2rem;
    font-size: 0.875rem;
    font-family: inherit;
    font-weight: 500;
    background: var(--accent);
    color: #0f0f0f;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .btn:hover { opacity: 0.85; }

  /* ── RESPONSIVE ── */
  @media (max-width: 700px) {
    .featured-grid { grid-template-columns: 1fr; }
    .featured-card--big { grid-column: 1; }
    .post-item { grid-template-columns: 1fr; }
    .post-thumb { width: 100%; height: 160px; }
    .newsletter-form { flex-direction: column; }
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .featured-grid { animation: fadeUp 0.5s ease both; }
  .posts-list { animation: fadeUp 0.5s ease 0.1s both; }
  .newsletter { animation: fadeUp 0.5s ease 0.2s both; }
</style>